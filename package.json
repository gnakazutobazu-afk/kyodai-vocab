{
  "name": "kyodai-vocab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/ssg_build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch:excel": "python3 scripts/watch_excel.py",
    "convert": "cd ~/kyotan && python3 export_site.py ~/kyodai-vocab/public/data/words.json && cd web && python3 merge.py ~/kyodai-vocab/public/data/words.json && python3 align.py ~/kyodai-vocab/public/data/words.json && python3 ety_merge.py ~/kyodai-vocab/public/data/words.json",
    "deploy": "npm run convert && npx vercel --prod --yes"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
